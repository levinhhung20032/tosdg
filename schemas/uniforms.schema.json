{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Uniform variants",
 "type": "object",
 "required": [
  "schema_version",
  "uniforms"
 ],
 "additionalProperties": false,
 "properties": {
  "schema_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+$"
  },
  "country": {
   "type": "string"
  },
  "uniforms": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "description",
     "proxy_colors"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_\\-]+$"
     },
     "description": {
      "type": "string"
     },
     "weight": {
      "type": "number",
      "minimum": 0
     },
     "verified": {
      "type": "boolean"
     },
     "unreal": {
      "type": "object"
     },
     "mesh": {
      "$comment": "schema 1.1: skinned GLB + garment spec for the 'mesh' render backend; paths are relative to the profile folder",
      "type": "object",
      "required": [
       "asset"
      ],
      "oneOf": [
       {
        "required": [
         "spec"
        ]
       },
       {
        "required": [
         "fit"
        ]
       }
      ],
      "additionalProperties": false,
      "properties": {
       "asset": {
        "type": "string",
        "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_\\-][A-Za-z0-9_./\\-]*\\.glb$"
       },
       "spec": {
        "$comment": "garment spec the GLB was generated from (tools/build_uniform_mesh.py)",
        "type": "string",
        "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_\\-][A-Za-z0-9_./\\-]*\\.json$"
       },
       "fit": {
        "$comment": "alternative to spec: the GLB is an imported textured static model rigged with these settings (tosdg import-model)",
        "type": "string",
        "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_\\-][A-Za-z0-9_./\\-]*\\.json$"
       }
      }
     },
     "proxy_colors": {
      "type": "object",
      "required": [
       "torso",
       "upper_arm",
       "forearm",
       "hand",
       "finger",
       "neck",
       "head",
       "headwear",
       "pelvis",
       "thigh",
       "shin",
       "foot"
      ],
      "additionalProperties": {
       "type": "array",
       "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
       },
       "minItems": 3,
       "maxItems": 3
      }
     }
    }
   }
  }
 }
}
